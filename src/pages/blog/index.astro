---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import BlogBrowser from '../../components/BlogBrowser.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import TerminalWindow from '../../components/TerminalWindow.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getDescriptions } from '../../lib/postMeta';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const descriptions = getDescriptions();
const activeTag = Astro.url.searchParams.get('tag') ?? '';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="flex-1 px-4 py-8 sm:px-6">
			<TerminalWindow path="~/blog$ browse" class="mx-auto max-w-[80ch]">
				<BlogBrowser posts={posts} descriptions={descriptions} activeTag={activeTag} />
			</TerminalWindow>
		</main>
		<Footer />
	</body>
</html>
