---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TypingQuotes from '../components/TypingQuotes.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const EMOJI: Record<string, string> = {
	research: '🔬',
	'computer-science': '💻',
	learning: '📚',
	projects: '🛠️',
	fun: '🎉',
};
const FALLBACK_EMOJI = '🏷️';

const QUOTES = [
	'The good thing about science is that it’s true whether or not you believe in it. — Neil deGrasse Tyson',
	'Somewhere, something incredible is waiting to be known. — Carl Sagan',
	'Imagination is more important than knowledge. — Albert Einstein',
	'The most exciting phrase to hear in science is not "Eureka!" but "That’s funny…" — Isaac Asimov',
	'Equipped with his five senses, man explores the universe and calls the adventure Science. — Edwin Hubble',
];

const posts = await getCollection('blog');
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="flex-1 px-4 sm:px-6">
			<section class="mx-auto flex min-h-[36vh] max-w-3xl flex-col items-center justify-center py-12 text-center">
				<h1 class="text-4xl font-bold text-ctp-text sm:text-5xl">Welcome to my Blog!</h1>
				<p class="mt-3 text-lg text-ctp-subtext1">Ready to dive into science and tech</p>
				<p class="mt-6 min-h-[3.5rem] px-4 font-mono text-sm text-ctp-subtext1 sm:text-base">
					<TypingQuotes quotes={QUOTES} />
				</p>
			</section>

			<div class="mx-auto mt-4 mb-16 grid max-w-3xl grid-cols-2 gap-4 sm:grid-cols-3">
				<a
					href="/blog"
					class="flex flex-col items-center gap-2 rounded-lg border border-ctp-surface0 bg-ctp-mantle px-4 py-6 text-center no-underline transition-colors hover:border-ctp-mauve"
				>
					<span class="text-3xl">🗂️</span>
					<span class="font-mono text-sm text-ctp-text">all posts</span>
				</a>
				{tags.map((tag) => (
					<a
						href={`/blog?tag=${encodeURIComponent(tag)}`}
						class="flex flex-col items-center gap-2 rounded-lg border border-ctp-surface0 bg-ctp-mantle px-4 py-6 text-center no-underline transition-colors hover:border-ctp-mauve"
					>
						<span class="text-3xl">{EMOJI[tag] ?? FALLBACK_EMOJI}</span>
						<span class="font-mono text-sm text-ctp-text">{tag}</span>
					</a>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
