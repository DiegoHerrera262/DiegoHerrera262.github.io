---
interface Props {
	/** Fake path/command shown in the window titlebar, e.g. "~/blog/my-post.md" */
	path?: string;
	class?: string;
}

const { path = '~', class: className } = Astro.props;
---

<div
	class:list={[
		'mx-auto w-full overflow-hidden rounded-lg border border-ctp-surface0 bg-ctp-mantle shadow-xl shadow-ctp-crust/40',
		className,
	]}
>
	<div class="flex items-center gap-2 border-b border-ctp-surface0 bg-ctp-crust/40 px-4 py-2.5">
		<span class="h-3 w-3 rounded-full bg-ctp-red"></span>
		<span class="h-3 w-3 rounded-full bg-ctp-yellow"></span>
		<span class="h-3 w-3 rounded-full bg-ctp-green"></span>
		<span class="ml-2 truncate font-mono text-xs text-ctp-subtext1">{path}</span>
	</div>
	<div class="p-4 sm:p-6">
		<slot />
	</div>
</div>
