---
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer class="border-t border-ctp-surface0 bg-ctp-mantle py-8 text-center">
	<p class="text-sm text-ctp-text">
		<span class="text-ctp-green">visitor</span><span class="text-ctp-subtext0">@</span><span
			class="text-ctp-blue">footer</span
		><span class="text-ctp-subtext0">:~$</span>
		<span class="text-ctp-mauve">echo</span> "&copy; {today.getFullYear()} Diego Herrera. All rights reserved."
	</p>
	<div class="mt-4 flex items-center justify-center gap-4">
		<SocialLinks />
	</div>
</footer>
