---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';

const host = SITE_TITLE.toLowerCase().replace(/\s+/g, '-');
---

<header class="border-b border-ctp-surface0 bg-ctp-mantle">
	<nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6">
		<a href="/" class="flex items-baseline gap-0.5 text-sm no-underline sm:text-base">
			<span class="text-ctp-green">visitor</span><span class="text-ctp-subtext0">@</span><span
				class="text-ctp-blue">{host}</span
			><span class="text-ctp-subtext0">:~$</span>
		</a>
		<div class="flex items-center gap-1">
			<HeaderLink href="/">home</HeaderLink>
			<HeaderLink href="/blog">blog</HeaderLink>
			<HeaderLink href="/about">about</HeaderLink>
		</div>
		<div class="hidden items-center gap-3 sm:flex">
			<SocialLinks />
		</div>
	</nav>
</header>
